[Unit]
Description=Campus Information AI Assistant Streamlit Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/gsm-hackathon
ExecStart=/home/ubuntu/gsm-hackathon/venv/bin/streamlit run app.py --server.address 127.0.0.1 --server.port 8501 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5
Environment=AWS_DEFAULT_REGION=us-east-1
Environment=HOME=/home/ubuntu

[Install]
WantedBy=multi-user.target
