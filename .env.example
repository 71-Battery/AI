# ===== 서버 =====
PORT=3000

# ===== AI 요약 (Amazon Bedrock) =====
# 미설정 시 자동으로 간단 추출 요약(폴백)으로 동작합니다.
# Bedrock을 쓰려면 AWS 자격증명(아래 AWS 섹션)과 모델 접근 권한이 필요합니다.
AI_PROVIDER=bedrock            # bedrock | none
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_REGION=us-east-1

# ===== 알림 채널 =====
# 콤마로 여러 개 지정 가능: console,slack,email
NOTIFY_CHANNELS=console

# Slack Incoming Webhook URL (slack 채널 사용 시)
SLACK_WEBHOOK_URL=

# 이메일 (email 채널 사용 시, AWS SES)
EMAIL_FROM=noreply@example.com
EMAIL_TO=you@example.com
SES_REGION=us-east-1

# ===== AWS 자격증명 (Bedrock/SES 사용 시) =====
# EC2에서 IAM Role을 쓰면 아래 키는 비워둬도 됩니다(권장).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ===== 외부 소스 폴링 (옵션) =====
# 외부 공지 목록을 주기적으로 확인해 새 항목을 자동 감지합니다.
POLL_ENABLED=false
POLL_SOURCE_URL=
POLL_CRON=*/5 * * * *          # 5분마다
